:root{--bg:#faf8f4;--card:#fff;--ink:#1d2433;--mute:#667085;--line:#e4dfd5;--acc:#e0552b;--acc2:#1f6f5c;--soft:#fdeee8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14161c;--card:#1d2029;--ink:#eceef3;--mute:#9aa3b5;--line:#2c3140;--acc:#ff7a4d;--acc2:#4fc2a5;--soft:#2b2420;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#14161c;--card:#1d2029;--ink:#eceef3;--mute:#9aa3b5;--line:#2c3140;--acc:#ff7a4d;--acc2:#4fc2a5;--soft:#2b2420;color-scheme:dark}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:760px;margin:0 auto;padding:20px 16px 48px}
h1{font-family:Georgia,"Times New Roman",serif;font-size:1.9rem;margin:6px 0 2px}
.sub{color:var(--mute);margin:0 0 18px}
nav{display:flex;gap:6px;border-bottom:1px solid var(--line);margin-bottom:18px;overflow-x:auto}
nav button{background:none;border:0;color:var(--mute);font:inherit;font-weight:600;padding:10px 14px;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
nav button.on{color:var(--acc);border-color:var(--acc)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:14px}
.topic{font-family:Georgia,serif;font-size:1.45rem;line-height:1.3;margin:6px 0 12px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
select,textarea,input{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:9px 11px}
textarea{width:100%;min-height:130px;resize:vertical}
.btn{background:var(--acc);color:#fff;border:0;border-radius:10px;padding:10px 16px;font:inherit;font-weight:600;cursor:pointer}
.btn.alt{background:var(--soft);color:var(--acc)}.btn.g{background:var(--acc2)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.timer{font-size:3rem;font-weight:700;font-variant-numeric:tabular-nums;color:var(--acc)}
.bar{height:8px;background:var(--line);border-radius:8px;overflow:hidden;margin:6px 0 12px}
.bar i{display:block;height:100%;background:var(--acc);width:0;transition:width .3s}
.mute{color:var(--mute);font-size:.92rem}
.score{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin:10px 0}
.score div{background:var(--soft);border-radius:10px;padding:10px;text-align:center}
.score b{display:block;font-size:1.5rem;color:var(--acc)}
.chat{display:flex;flex-direction:column;gap:8px;max-height:420px;overflow-y:auto;margin-bottom:10px}
.msg{padding:9px 12px;border-radius:12px;background:var(--bg);border:1px solid var(--line)}
.msg.me{background:var(--soft);align-self:flex-end;max-width:90%}
.msg small{display:block;font-weight:700;color:var(--acc2)}
.msg.me small{color:var(--acc)}
ul{padding-left:20px}li{margin:4px 0}
.hide{display:none}
.fb h3{margin:14px 0 4px;font-size:1rem}
